{
    "name": "silvershop/product-feed-google",
    "description": "Google Merchant channel connector for silvershop/product-feed (CMS 6): an RSS 2.0 + g: namespace serializer and field map that turns the shared CatalogProductData into a Google Shopping product feed, plus a bundled Google product taxonomy with per-category mapping. Registers itself into the product-feed core's channel registry — no core change.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "product-feed", "google-shopping", "google-merchant", "rss", "merchant-center"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-product-feed-google/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silvershop/core": "^6.2",
        "silvershop/product-feed": "dev-main"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\ProductFeed\\Google\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\ProductFeed\\Google\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
